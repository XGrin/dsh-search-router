{
  "name": "dsh-search-router",
  "version": "0.3.0",
  "description": "Route DSH's native web_search tool to user-configurable search providers with sequential fallback. The plugin is a router, not a search engine.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./client": {
      "default": "./src/client/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-search",
    "search-router",
    "exa",
    "tavily",
    "brave",
    "perplexity",
    "deepseek",
    "searxng",
    "duckduckgo",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings-file": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2"
  },
  "scripts": {
    "providers": "node scripts/gen-providers.mjs",
    "test": "node --test \"test/*.mjs\""
  },
  "prepare": "node scripts/gen-providers.mjs"
}
